# Veydeck 本地开发环境配置示例。

# 开发产物根目录。数据库、日志、运行时配置和本地 Agent socket 默认都收敛到该目录下。
VEYDECK_DATA_DIR=.veydeck

# SQLite 数据库目录。主控使用 veydeck.db，Agent 使用 agent.db。
VEYDECK_DB_DIR=.veydeck/database

# tracing JSON Lines 运行日志目录。服务会在该目录下创建 veydeck/ 与 agent/ 子目录。
VEYDECK_LOG_DIR=.veydeck/logs

# 开发期配置文件目录。veydeck.toml、agent.toml、runtime-listen.json/key 可放在这里。
VEYDECK_CONFIG_DIR=.veydeck/config

# 本地模式下主控连接 Agent 使用的 Unix socket。
VEYDECK_AGENT_SOCKET=.veydeck/veydeck-agent.sock

# 可选：运行日志级别。
RUST_LOG=info

# 生产环境通常不使用本文件，而是由 systemd、容器编排或部署脚本注入环境变量。
# 生产环境推荐只设置应用根目录，其他路径默认由 VEYDECK_HOME 推导。
# VEYDECK_HOME=/opt/veydeck
#
# 如需单独挂载数据库、日志或运行目录，可继续使用单项变量覆盖：
# VEYDECK_DB_DIR=/data/veydeck/database
# VEYDECK_LOG_DIR=/data/veydeck/logs
# VEYDECK_CONFIG_DIR=/opt/veydeck/config
# VEYDECK_AGENT_SOCKET=/opt/veydeck/run/veydeck-agent.sock
